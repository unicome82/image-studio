{
  "name": "image-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types scripts/promptBuilder.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"scripts/**/*.ts\" vite.config.ts package.json tsconfig.json .prettierrc.json \".github/workflows/*.yml\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"scripts/**/*.ts\" vite.config.ts package.json tsconfig.json .prettierrc.json \".github/workflows/*.yml\" index.html"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.4.2",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
